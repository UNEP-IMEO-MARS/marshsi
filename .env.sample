# Sample environment file for running the docs/ notebook integration tests.
#
# Copy to `.env` (git-ignored) and fill in the values you have. docs/conftest.py
# loads this file automatically (via python-dotenv) before running the notebooks,
# so any credentials/config set here are picked up by the notebook kernels.
# Each block is optional — notebooks whose inputs are absent are simply skipped.

# --- Azure: UNEP IMEO container (PRISMA / EnMAP) ----------------------------
# Read-only SAS token for the Azure container; used by prisma_example and
# enmap_example to download the test rasters.
SAS_TOKEN=sv=2024-01-01&ss=b&srt=co&sp=rl&se=2030-01-01T00:00:00Z&sig=REPLACE_ME
AZURE_STORAGE_ACCOUNT=mystorageacount
CONTAINER_NAME=mycontainer

# --- NASA Earthdata (EMIT) --------------------------------------------------
# Bearer token from https://urs.earthdata.nasa.gov/profile; used by emit_example
# to download the EMIT radiance scene.
EARTHDATA_TOKEN=eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9.REPLACE_ME
